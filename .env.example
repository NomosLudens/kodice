# ==============================================================================
# Kódice — Environment Configuration Example
# ==============================================================================
# All variables are OPTIONAL.
# The project runs out-of-the-box locally without creating a .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
# Optional remote sync (Supabase). If unset or invalid, Kódice runs in
# local-first mode using IndexedDB and localStorage (zero cloud dependency).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legal API base URL for the web reader.
# In local development (bun run dev:full), defaults to /api/legal proxied to :4520.
# In production, defaults to https://api.kodice.nomosludens.ia.br/api/legal.
# VITE_KODICE_LEGAL_API_URL=https://api.kodice.nomosludens.ia.br/api/legal

# Optional external Station URL for remote library sync.
# Defaults to empty (unconfigured, fully local).
# VITE_KODICE_STATION_URL=

# ------------------------------------------------------------------------------
# Legal API Server (Node / SQLite backend)
# ------------------------------------------------------------------------------
# Path to the SQLite database.
# Defaults to ./legal.db in local directory (or /var/lib/kodice/legal.db if present).
# KODICE_LEGAL_DB=./legal.db

# Server listen port (default: 4520)
# KODICE_LEGAL_PORT=4520

# Server listen host (default: 127.0.0.1)
# KODICE_LEGAL_HOST=127.0.0.1

# Comma-separated list of additional allowed CORS origins.
# http://localhost:5173, http://127.0.0.1:5173, and https://kodice.nomosludens.ia.br
# are allowed by default.
# KODICE_ALLOWED_ORIGINS=https://my-domain.example

# Set to 1 to enable Access-Control-Allow-Private-Network header (default: off).
# KODICE_ALLOW_PRIVATE_NETWORK=0

# Set to 1 to run backend in read-only mode (disables POST /api/legal/norms/download).
# KODICE_LEGAL_READONLY=1
